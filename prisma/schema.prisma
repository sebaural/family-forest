// Prisma schema — https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime queries (transaction pooler)
  directUrl = env("DIRECT_URL") // migrations only (session pooler)
}

// ── Users ─────────────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // null for OAuth users
  avatarUrl     String? // uploaded profile picture (R2); falls back to the OAuth image
  role          UserRole  @default(USER)

  digestEnabled        Boolean  @default(true)
  inviteAcceptedNotify Boolean  @default(true)
  onboardingStep       Int      @default(0) // 0 not started, 1 tree named, 2 self added, 3 complete
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  userSessions   UserSession[]
  trees          FamilyTree[]
  subscription   Subscription?
  collaborations TreeCollaborator[]

  invitationsSent     Invitation[]  @relation("invitationsSent")
  invitationsAccepted Invitation[]  @relation("invitationsAccepted")
  activity            ActivityLog[]
}

enum UserRole {
  USER
  ADMIN
}

// ── NextAuth adapter tables ────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// One row per signed-in device. The JWT carries its id (`sid`); a revoked or
/// missing row ends that session on its next request.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Family trees ──────────────────────────────────────────────────────────
model FamilyTree {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators TreeCollaborator[]
  members       Member[]
  relationships Relationship[]
  invitations   Invitation[]
  activity      ActivityLog[]
}

// ── Collaborators ─────────────────────────────────────────────────────────
model TreeCollaborator {
  treeId     String
  userId     String
  role       CollabRole @default(VIEWER)
  createdAt  DateTime   @default(now())
  // null while an invite sent by a non-owner awaits the owner's approval: no access yet.
  approvedAt DateTime?

  tree FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([treeId, userId])
  @@index([treeId, approvedAt])
}

enum CollabRole {
  EDITOR
  VIEWER
}

// ── Subscriptions ─────────────────────────────────────────────────────────
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionPlan {
  FREE
  PRO
  FAMILY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ── Domain models ─────────────────────────────────────────────────────────
model Member {
  id         String    @id @default(cuid())
  treeId     String
  firstName  String
  lastName   String
  birthDate  DateTime?
  deathDate  DateTime?
  birthPlace String?
  bio        String?   @db.Text
  photoUrl   String?
  userId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tree     FamilyTree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  asParent Relationship[] @relation("fromMember")
  asChild  Relationship[] @relation("toMember")

  @@index([treeId])
}

// For PARENT_CHILD, `from` is the parent and `to` is the child.
model Relationship {
  id     String  @id @default(cuid())
  treeId String
  type   RelType
  fromId String
  toId   String

  tree FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  from Member     @relation("fromMember", fields: [fromId], references: [id], onDelete: Cascade)
  to   Member     @relation("toMember", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([treeId])
}

enum RelType {
  PARENT_CHILD
  SPOUSE
  PARTNER
}

// Status is derived: accepted when acceptedAt is set, expired after expiresAt, otherwise pending.
model Invitation {
  id           String     @id @default(cuid())
  treeId       String
  email        String // stored lower-cased
  role         CollabRole @default(VIEWER)
  tokenHash    String     @unique // SHA-256 of the signed invite JWT; the raw token is never stored
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String?
  acceptedById String?
  createdAt    DateTime   @default(now())

  tree       FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  invitedBy  User?      @relation("invitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?      @relation("invitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([treeId])
}

// Who changed what in a tree. The description is a snapshot ("Alice added Jane
// Doe (1942–2018)"), so entries stay readable after members or users are deleted.
model ActivityLog {
  id          String   @id @default(cuid())
  treeId      String
  actorId     String? // null once the acting user is deleted
  action      String // MEMBER_ADDED, MEMBER_UPDATED, MEMBER_DELETED, RELATIONSHIP_ADDED, RELATIONSHIP_REMOVED
  description String
  createdAt   DateTime @default(now())

  tree  FamilyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  actor User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([treeId, createdAt(sort: Desc)])
}
