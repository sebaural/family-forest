# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/familyforest"

# Direct (non-pgbouncer) connection used by Prisma migrations only.
# On Supabase: the session pooler (port 5432); DATABASE_URL uses the transaction pooler (6543).
DIRECT_URL="postgresql://postgres:password@localhost:5432/familyforest"

# Secret used to sign/encrypt NextAuth JWTs and cookies (min 32 chars).
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-a-random-string-of-at-least-32-chars"

# Google OAuth credentials (optional). The Google sign-in button only appears when both are set.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth app credentials (optional). The GitHub sign-in button only appears when both are set.
# https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare R2 bucket for member pictures (optional). The Picture field only appears when all five are set.
# The bucket needs public access (r2.dev or a custom domain) and a CORS rule allowing PUT and GET
# with the Content-Type header from the app's origins.
# https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL of the bucket, no trailing slash, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=""

# Resend, for invite emails (optional). Without it, the Share dialog only offers "Copy invite link".
# RESEND_FROM must use a domain verified in Resend, e.g. "FamilyForest <invites@example.com>".
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM=""

# Supabase Realtime, for live updates between collaborators (optional).
# Project Settings → API. The service-role (secret) key stays server-side and only broadcasts.
# Realtime must allow public channels.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public base URL of the app (exposed to the browser).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
