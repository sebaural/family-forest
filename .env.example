# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/familyforest"

# Direct (non-pgbouncer) connection used by Prisma migrations only.
# On Supabase: the session pooler (port 5432); DATABASE_URL uses the transaction pooler (6543).
DIRECT_URL="postgresql://postgres:password@localhost:5432/familyforest"

# Secret used to sign/encrypt NextAuth JWTs and cookies (min 32 chars).
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-a-random-string-of-at-least-32-chars"

# Google OAuth credentials (optional). The Google sign-in button only appears when both are set.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth app credentials (optional). The GitHub sign-in button only appears when both are set.
# https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public base URL of the app (exposed to the browser).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
