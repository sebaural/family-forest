    "@supabase/supabase-js": "^2.119.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "5",
    "@trpc/client": "11",
    "@trpc/next": "11",
    "@trpc/react-query": "11",
    "@trpc/server": "11",
    "bcryptjs": "^3.0.3",
